{
  "rewrites": [
    {
      "source": "/api/proxy/operation/(.*)",
      "destination": "https://workflow-operation-api-n9sbp.ondigitalocean.app/api/$1"
    },
    {
      "source": "/api/proxy/online/(.*)",
      "destination": "https://workflow-online-api-nr3e4.ondigitalocean.app/api/$1"
    },
    {
      "source": "/api/proxy/github/(.*)",
      "destination": "https://github.com/$1"
    },
    {
      "source": "/api/proxy/copilot/(.*)",
      "destination": "https://api.githubcopilot.com/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
